{
  "name": "gym-tracking-system",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev",
    "dev:tunnel": "node scripts/dev-tunnel.mjs",
    "build": "next build --webpack",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --keep-vars",
    "deploy:supabase:check": "supabase db push --dry-run",
    "deploy:supabase": "supabase db push",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test scripts/lib/csv-parser.node-test.mjs",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test",
    "check:commit": "npm run check",
    "check:release": "npm run check && npm run build",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "owner:provision": "node --env-file=.env.local scripts/provision-owner.mjs",
    "owner:access": "node --env-file=.env.local scripts/set-owner-access.mjs",
    "data:backup": "node --env-file=.env.local scripts/backup-gym.mjs",
    "data:import": "node --env-file=.env.local scripts/import-members.mjs",
    "ops:preflight": "node scripts/check-production-env.mjs",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@supabase/server": "^1.4.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.3",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "supabase": "^2.114.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.9",
    "wrangler": "^4.127.1"
  }
}
