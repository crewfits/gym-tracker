RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=Gym Desk <notifications@example.com>
NEXT_PUBLIC_APP_URL=http://localhost:3000
QR_SIGNING_SECRET=replace-with-at-least-32-random-bytes
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=91
