NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: Cloudflare Email Service sender settings.
# Production uses the EMAIL binding in wrangler.jsonc; local Next.js dev does not send
# through the binding unless running through Wrangler/OpenNext.
EMAIL_FROM=FitKiro <notifications@fitkiro.com>
EMAIL_REPLY_TO=support@fitkiro.com
# Required for /api/jobs/email-reminders and Cloudflare cron.
EMAIL_REMINDER_JOB_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000
QR_SIGNING_SECRET=replace-your-long-random-secret
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=91
