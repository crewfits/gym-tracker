NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Set only while running owner:provision; do not deploy this variable.
FITKIRO_OWNER_PASSWORD=provisioning-only-temporary-password
# Optional: only required for receipt-email convenience; not used for reminders.
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=FitKiro <notifications@your-verified-domain.example>
# Required for automated WhatsApp reminders through Meta Cloud API.
WHATSAPP_ACCESS_TOKEN=your-system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
WHATSAPP_GRAPH_API_VERSION=v23.0
# Required only for the secured automated reminder endpoint.
CRON_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000
