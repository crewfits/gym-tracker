{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fitkiro",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://musclefitness.fitkiro.com",
    "NEXT_PUBLIC_DEFAULT_COUNTRY_CODE": "91"
  },
  "routes": [
    {
      "pattern": "musclefitness.fitkiro.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "env": {
    "dev": {
      "name": "fitkiro-dev",
      "vars": {
        "NEXT_PUBLIC_APP_URL": "https://dev.fitkiro.com",
        "NEXT_PUBLIC_DEFAULT_COUNTRY_CODE": "91"
      },
      "routes": [
        {
          "pattern": "dev.fitkiro.com",
          "custom_domain": true
        }
      ],
      "observability": {
        "enabled": true
      }
    },
    "prod": {
      "name": "fitkiro",
      "vars": {
        "NEXT_PUBLIC_APP_URL": "https://musclefitness.fitkiro.com",
        "NEXT_PUBLIC_DEFAULT_COUNTRY_CODE": "91"
      },
      "routes": [
        {
          "pattern": "musclefitness.fitkiro.com",
          "custom_domain": true
        }
      ],
      "observability": {
        "enabled": true
      }
    }
  }
}
